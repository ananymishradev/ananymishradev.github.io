---
import { getEntry, render } from "astro:content";
import config from "virtual:astro-sage/user-config";
import Layout from "@sage/layouts/Layout.astro";
import Header from "@sage/components/Header.astro";
import Main from "@sage/components/Main.astro";
import Footer from "@sage/components/Footer.astro";

const contact = await getEntry("pages", "contact");

if (!contact) {
  throw new Error(
    "Missing content entry: `contact.md` or `contact.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(contact);
---

<Layout
  title={`${contact.data.title} | ${config.site.title}`}
  description={contact.data.description}
  ogImage={contact.data.ogImage}
  canonicalURL={contact.data.canonicalURL}
>
  <Header />

  <Main pageTitle={contact.data.title}>
    <!-- The prose flow rules style direct children, so wrap the content itself. -->
    <div class="app-prose mt-6">
      <Content />
    </div>
  </Main>

  <Footer />
</Layout>
